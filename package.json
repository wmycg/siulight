{
  "name": "siulight",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "pnpm db:generate && tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "pnpm db:migrate:deploy && NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx server/db/seed.ts",
    "setup": "pnpm db:up && pnpm db:shadow && pnpm db:migrate && pnpm db:generate && pnpm db:seed",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "format": "prettier --write src server shared tests docs *.json *.ts *.yaml *.md",
    "format:check": "prettier --check src server shared tests docs *.json *.ts *.yaml *.md",
    "deploy": "pnpm build && pnpm start",
    "db:generate": "prisma generate",
    "db:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:shadow": "docker compose exec -T mysql sh /docker-entrypoint-initdb.d/01-shadow.sh",
    "test:migrations": "tsx --test tests/migrations.database.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.0",
    "multer": "^2.3.0",
    "mysql2": "^3.19.0",
    "pnpm": "^12.4.1",
    "prisma": "7.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.27.3",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@11.22.0"
}
