generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Application {
  id         String            @id @db.Char(36)
  nickname   String            @db.VarChar(20)
  realName   String            @db.VarChar(30)
  studentId  String            @unique(map: "studentId") @db.VarChar(25)
  qq         String            @db.VarChar(15)
  department String            @db.VarChar(30)
  note       String            @default("") @db.VarChar(500)
  status     ApplicationStatus @default(pending)
  createdAt  DateTime          @default(now()) @db.Timestamp(0)

  @@map("applications")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String   @db.VarChar(40)
  action    String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(0)

  @@map("audit_logs")
}

model EventAttendee {
  eventId String @db.Char(36)
  userId  String @db.Char(36)
  events  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "event_attendees_ibfk_1")
  users   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "event_attendees_ibfk_2")

  @@id([eventId, userId])
  @@index([userId], map: "userId")
  @@map("event_attendees")
}

model Event {
  id              String          @id @db.Char(36)
  title           String          @db.VarChar(80)
  date            DateTime        @db.Date
  place           String          @db.VarChar(100)
  brief           String          @db.VarChar(160)
  body            String          @db.Text
  image           String          @default("") @db.VarChar(255)
  category        String          @db.VarChar(20)
  capacity        Int             @default(30)
  createdAt       DateTime        @default(now()) @db.Timestamp(0)
  event_attendees EventAttendee[]
  milestones      Milestone[]

  @@index([date], map: "event_date")
  @@map("events")
}

model Like {
  milestoneId String    @db.Char(36)
  userId      String    @db.Char(36)
  milestones  Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "likes_ibfk_1")
  users       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "likes_ibfk_2")

  @@id([milestoneId, userId])
  @@index([userId], map: "userId")
  @@map("likes")
}

model MilestoneParticipant {
  milestoneId String    @db.Char(36)
  userId      String    @db.Char(36)
  milestones  Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "milestone_participants_ibfk_1")
  users       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "milestone_participants_ibfk_2")

  @@id([milestoneId, userId])
  @@index([userId], map: "userId")
  @@map("milestone_participants")
}

model Milestone {
  eventId                String?                @db.Char(36)
  event                  Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  id                     String                 @id @db.Char(36)
  authorId               String                 @db.Char(36)
  title                  String                 @db.VarChar(80)
  body                   String                 @db.Text
  date                   DateTime               @db.Date
  kind                   MilestoneKind
  category               String                 @db.VarChar(20)
  image                  String                 @default("") @db.VarChar(255)
  createdAt              DateTime               @default(now()) @db.Timestamp(0)
  likes                  Like[]
  milestone_participants MilestoneParticipant[]
  users                  User                   @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "milestones_ibfk_1")

  @@index([eventId, date], map: "milestone_event_date")
  @@index([authorId, date], map: "milestone_author")
  @@index([date, createdAt], map: "milestone_date")
  @@map("milestones")
}

model Session {
  tokenHash String   @id @db.Char(64)
  userId    String   @db.Char(36)
  expiresAt DateTime @db.DateTime(0)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_ibfk_1")

  @@index([expiresAt], map: "session_expiry")
  @@index([userId], map: "userId")
  @@map("sessions")
}

model User {
  id                     String                 @id @db.Char(36)
  email                  String                 @unique(map: "email") @db.VarChar(190)
  name                   String                 @db.VarChar(20)
  passwordHash           String                 @db.VarChar(255)
  role                   UserRole               @default(member)
  color                  String                 @default("#c16b51") @db.VarChar(20)
  bio                    String                 @default("") @db.VarChar(300)
  createdAt              DateTime               @default(now()) @db.Timestamp(0)
  event_attendees        EventAttendee[]
  likes                  Like[]
  milestone_participants MilestoneParticipant[]
  milestones             Milestone[]
  sessions               Session[]
  wallNotes              WallNote[]

  @@map("users")
}

enum UserRole {
  member
  admin
  superadmin
}

enum MilestoneKind {
  personal
  club
}

enum ApplicationStatus {
  pending
  contacted
  accepted
}

model WallNote {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  nickname  String   @db.VarChar(20)
  color     String   @db.VarChar(12)
  userId    String?  @db.Char(36)
  guestHash String?  @db.Char(64)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@map("wall_notes")
}
