APP_ORIGIN=https://your-domain.example
# Optional comma-separated HTTPS origins, without trailing slashes.
APP_ORIGINS=https://your-domain.example,https://www.your-domain.example
APP_PORT=3000
APP_IMAGE=siulight-app:3.0.0
MYSQL_DATABASE=siulight
MYSQL_USER=siulight
# These values are also used in a URL; prefer: openssl rand -hex 24
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
